# systemd unit for the Streamlit dashboard.  Edit User, WorkingDirectory and paths, then:
#   sudo cp deploy/trustshield.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now trustshield
[Unit]
Description=TrustShield AI dashboard
After=network.target

[Service]
User=linux1
WorkingDirectory=/home/linux1/trustshield
EnvironmentFile=-/home/linux1/trustshield/.env
ExecStart=/home/linux1/trustshield/venv/bin/streamlit run app.py --server.port 8501 --server.address 127.0.0.1
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
